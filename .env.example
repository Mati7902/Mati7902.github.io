# ============================================================
# Psicología Matías Sánchez — variables de entorno
# Copiá este archivo a .env.local y completá los valores.
# NUNCA subas claves reales al repositorio.
# ============================================================

# ---------- Aplicación ----------
# URL pública del sitio (sin barra final). Se usa para links de email, OAuth y metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Zona horaria operativa de la práctica (IANA).
NEXT_PUBLIC_DEFAULT_TIMEZONE=America/Asuncion

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública (publishable key nueva o anon key legacy). Es segura en el navegador
# porque todas las tablas están protegidas por RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Clave de servicio: SOLO en el servidor (server actions, webhooks, crons). Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: cadena de conexión directa para scripts (seed, tests de base de datos).
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---------- Seguridad ----------
# Clave de 32 bytes en base64 para cifrar tokens OAuth guardados en la base (AES-256-GCM).
# Generar con: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Secreto que Vercel envía en el header Authorization de los cron jobs.
CRON_SECRET=

# ---------- Meta / WhatsApp Cloud API ----------
# Token de acceso del System User (permanente) con permisos whatsapp_business_messaging.
META_WHATSAPP_TOKEN=
# ID del número de teléfono (Phone Number ID) en WhatsApp Manager.
META_WHATSAPP_PHONE_NUMBER_ID=
# ID de la cuenta de WhatsApp Business (WABA).
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
# Token arbitrario que definís vos y repetís en la configuración del webhook de Meta.
META_WEBHOOK_VERIFY_TOKEN=
# App Secret de la app de Meta: se usa para validar la firma X-Hub-Signature-256 de cada webhook.
META_APP_SECRET=
# Versión de Graph API. Verificar la vigente en developers.facebook.com antes de desplegar.
META_GRAPH_API_VERSION=v23.0

# ---------- Google Calendar ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir exactamente con la URI autorizada en Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# ---------- IA del chatbot (capa independiente del proveedor) ----------
# Proveedor: anthropic | openai | rules (solo reglas, sin IA)
AI_PROVIDER=rules
AI_PROVIDER_API_KEY=
# Modelo a usar para clasificar intenciones. Ejemplos: claude-haiku-4-5-20251001 | gpt-4o-mini
AI_MODEL=claude-haiku-4-5-20251001

# ---------- Observabilidad (opcional) ----------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=info
